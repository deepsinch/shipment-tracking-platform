# Copy to .env and adjust. .env is gitignored.

# PostgreSQL 16. Local dev role/databases (see README "Local setup"):
#   CREATE ROLE waybill WITH LOGIN PASSWORD 'waybill' CREATEDB;
#   CREATE DATABASE waybill OWNER waybill;
#   CREATE DATABASE waybill_test OWNER waybill;
# CREATEDB lets `pnpm test:e2e` create waybill_e2e itself on first run.
DATABASE_URL=postgres://waybill:waybill@localhost:5432/waybill
TEST_DATABASE_URL=postgres://waybill:waybill@localhost:5432/waybill_test
# Wiped and re-migrated by every `pnpm test:e2e` run; the name must end in _e2e.
E2E_DATABASE_URL=postgres://waybill:waybill@localhost:5432/waybill_e2e

# The app validates the variables below with Zod on first use (src/server/env.ts) and names any
# that are missing or malformed. Blank means unset.

# Direct (session) connection for the realtime listener (LISTEN waybill_events). LISTEN does not
# work through a transaction-mode pooler: on Neon, DATABASE_URL is the pooled endpoint (host
# contains "-pooler") and this is the direct one (same host without "-pooler"); with PgBouncer,
# point this at Postgres itself. Each server instance holds one such connection. Leave it empty
# locally, where there is no pooler: the listener then uses DATABASE_URL.
# If unset, DATABASE_URL_UNPOOLED is used (the name the Neon integration on Vercel injects), then
# DATABASE_URL.
DATABASE_DIRECT_URL=
DATABASE_URL_UNPOOLED=

# Better Auth (required). The secret must be at least 32 characters; generate one with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-a-long-random-string
# The app's public origin. Required locally (http://localhost:3000). On Vercel leave it unset: it is
# derived from the deployment (https://$VERCEL_PROJECT_PRODUCTION_URL in production,
# https://$VERCEL_BRANCH_URL or $VERCEL_URL in previews) and every host of the deployment is
# trusted. Set it only for a custom domain.
BETTER_AUTH_URL=http://localhost:3000

# Optional: lifetime of one live-update stream in seconds (default 270, clamped to 5-290). Lower
# it below the hosting plan's function time limit if that is under 300 s.
REALTIME_STREAM_SECONDS=

# Optional: public demo mode ("true" or "false", default false). When true, the app shows a banner
# and one-click demo sign-in, moves the demo trucks while someone watches (/api/demo/tick), and
# exposes the nightly reset (/api/cron/reset-demo, called by Vercel Cron). The deploy build also
# creates the demo data. See docs/deployment.md.
DEMO_MODE=
# Required when DEMO_MODE=true: at least 16 characters (openssl rand -hex 32). Vercel Cron sends
# it as "Authorization: Bearer <value>"; anything else gets a 401.
CRON_SECRET=
# Required when DEMO_MODE=true: the name(s) of the database(s) the nightly reset may wipe,
# comma-separated (the database name in DATABASE_URL, e.g. neondb on Neon). A wipe of any other
# database is refused.
DEMO_RESET_DATABASES=
# Development and tests only: lets webhook URLs point at http://localhost. Refused on Vercel and in demo mode.
WEBHOOKS_ALLOW_LOCAL_TARGETS=
# Customer email notifications. Without both, messages are stored as previews (admins read them
# under Settings, Email previews) and nothing is sent. Demo mode never sends.
# RESEND_API_KEY is a Resend API key; EMAIL_FROM is e.g. "Waybill <notifications@your-domain>".
RESEND_API_KEY=
EMAIL_FROM=
